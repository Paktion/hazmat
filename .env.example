# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
# Then run:  hazmat check

# --- Meta Model API (hosted Muse models; $150 hackathon credits) -----------
# Create a key at https://dev.meta.ai -> API keys.
# Hosted calls only ever get sanitized content (see README).
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Baseten (Muse Spark Open; $100 credits + 2M TPM) -----------------------
# Your key is behind the one-time 1Password link in Baseten's email
# ("Your Baseten API key is ready"). Open it ONCE and paste the key here.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Local open-weights model (Muse Glimmer / Spark Open) -------------------
# Any OpenAI-compatible local server (Ollama, LM Studio, llama.cpp, vLLM).
# Leave blank until you have one running.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=local

# --- Fireworks ($25 hackathon credits) -----------------------------------------
# Create a key at https://app.fireworks.ai -> Settings -> API Keys.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# --- Modal (isolated sandboxes for running analysis tools) ---------------------
# Modal doesn't use a key in this file: run `modal setup` once, which saves a
# token to ~/.modal.toml. Workspace: paktion. GPUs need a card on file;
# CPU sandboxes (what Hazmat uses) work without one.

# --- Routing -------------------------------------------------------------------
# Which provider handles sensitive (unsanitized) content.
# Must be an open-weights provider.
HAZMAT_RAW_PROVIDER=baseten        # baseten | local | fireworks
# Which provider handles sanitized-only calls (report writing, summaries).
HAZMAT_SUMMARY_PROVIDER=meta       # meta | baseten | local | fireworks
